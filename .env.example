# Impartly settings template.
#
# Copy this file to .env.local and fill in the values.
# .env.local stays on your machine and is ignored by git.
# Never put a real key in this file: it is committed to the repository.

# --- Supabase (data, sign-in, storage, scheduling) ---
# Sign-in is required on every page. Users sign in with an email and password created in
# the Supabase project (Authentication > Users).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Full database access; never expose it to the browser.
SUPABASE_SECRET_KEY=

# --- Summaries: any OpenAI-compatible endpoint ---
# Works with hosted open-weight models or a model running on your own machine.
# SUMMARY_API_KEY may stay empty for a model on your own machine (http://localhost).
# `npm run eval:summaries` grades a real model only when SUMMARY_API_KEY is set
# (for a local model, any placeholder value will do).
SUMMARY_BASE_URL=
SUMMARY_API_KEY=
SUMMARY_MODEL=

# --- Conversation: questions and answers with web search ---
ANTHROPIC_API_KEY=
CONVERSATION_MODEL=
# Most web searches allowed per answer. Each search is billed.
MAX_SEARCHES_PER_ANSWER=2

# --- Mail access, read-only. Fill in the provider you use. ---
# Gmail: a Google Cloud OAuth client of type "Web application" that requests only
# the gmail.readonly scope. GOOGLE_REDIRECT_URI must match one of the client's
# authorized redirect URIs exactly (https, or http://localhost for development).
GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET is also the key material (via HKDF) for the short-lived encrypted
# cookie that holds the OAuth state and PKCE verifier during the connect flow.
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Scheduler ---
# A random string of at least 32 characters (shorter is refused). Supabase Cron sends it as
# "Authorization: Bearer ..." when it calls /api/cron/pull; store the same value in Supabase
# Vault as impartly_cron_secret (README, "The scheduled pull").
CRON_SECRET=
# Minutes before each user's delivery time that the pull starts (0 to 360; default 30).
PULL_LEAD_MINUTES=30
